# Copy to mcp-server/.env and fill in. Do NOT commit the real .env.
# Reuses the same Supabase project as the MoiMone backend.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The email of the MoiMone account whose finances this server should expose.
MOIMONE_USER_EMAIL=
# Optional — display currency code (defaults to LKR).
MOIMONE_CURRENCY=LKR
