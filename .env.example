# Copy this file to backend/.env and fill in real values.
# Do NOT commit your real .env.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Transaction parser ---
# 'ollama' (local, free) | 'groq' (hosted, free) | 'claude' (Anthropic, paid)
PARSER_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
# GROQ (for deployment): get a free key at console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Claude API (only if PARSER_PROVIDER=claude) ---
ANTHROPIC_API_KEY=

# --- Gmail (OAuth) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_BANK_SENDER=notifications@yourbank.com

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Security ---
# Random string; put the same value in your iOS Shortcut.
WEBHOOK_SECRET_TOKEN=

# --- App ---
PORT=3000
FRONTEND_URL=http://localhost:5173
