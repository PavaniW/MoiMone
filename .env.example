# Local dev: copy this file to backend/.env and fill in real values.
# Deployment (Netlify): set the same keys as environment variables in the UI.
# Do NOT commit your real .env.
#
# Required for the app to run: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# PARSER_PROVIDER (+ its key). The rest are optional (CRON_SECRET is required
# only if you enable the scheduled weekly-summary job).

# --- Supabase (required) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Transaction parser (required) ---
# 'ollama' (local only, free) | 'groq' (hosted, free) | 'claude' (Anthropic, paid)
# NOTE: on a hosted deploy (Netlify) use 'groq' or 'claude' — 'ollama' runs on
# your own machine and is unreachable from the cloud.
PARSER_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
# GROQ (recommended for deployment): get a free key at console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Claude API (only if PARSER_PROVIDER=claude) ---
ANTHROPIC_API_KEY=

# --- Gmail (OAuth) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_BANK_SENDER=notifications@yourbank.com

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Security ---
# Random string; gates the scheduled /cron/* jobs. REQUIRED to enable them — the
# endpoint fails closed (rejects every request) when this is unset. Vercel Cron
# sends it as a Bearer token automatically when set here as an env var.
CRON_SECRET=

# --- App ---
PORT=3000
FRONTEND_URL=http://localhost:5173
